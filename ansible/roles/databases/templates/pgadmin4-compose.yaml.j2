services:
  pgadmin:
    image: dpage/pgadmin4:latest
    container_name: pgadmin
    restart: unless-stopped

    env_file:
      - pgadmin.env

    volumes:
      - pgadmin_data:/var/lib/pgadmin

    networks:
      - database-net

    ports:
      - "8083:80"

volumes:
  pgadmin_data:

networks:
  database-net:
    name: database-net
    external: true