services:
  pgadmin:
    image: dpage/pgadmin4:latest
    container_name: pgadmin
    restart: unless-stopped

    environment:
      PGADMIN_DEFAULT_EMAIL: "{{ vault_pgadmin4.PGADMIN_DEFAULT_EMAIL }}"
      PGADMIN_DEFAULT_PASSWORD: "{{ vault_pgadmin4.PGADMIN_DEFAULT_PASSWORD }}"
    volumes:
      - pgadmin_data:/var/lib/pgadmin

    networks:
      - database-net

    ports:
      - "8083:80"

volumes:
  pgadmin_data:

networks:
  database-net:
    name: database-net
    external: true