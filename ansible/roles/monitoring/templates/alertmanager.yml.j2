global:
  resolve_timeout: 5m

route:
  receiver: 'slack-notifications'
  group_wait: 10s
  group_interval: 1m
  repeat_interval: 4h

receivers:
  - name: 'slack-notifications'
    slack_configs:
      - api_url: '{{ vault_slack.TOKEN }}'
        channel: '#alerts'
        send_resolved: true
        title: '{% raw %}{{ if eq .Status "firing" }}🔴 FIRING{{ else }}🟢 RESOLVED{{ end }}: {{ .CommonAnnotations.summary }}{% endraw %}'
        text: '{% raw %}{{ .CommonAnnotations.description }}{% endraw %}'
